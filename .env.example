# 复制为 .env.local 后填写。.env.local 已被 .gitignore 忽略，不会进入仓库。

# Crossref polite pool 联系邮箱（强烈建议填写团队邮箱：限流更宽松，核查速度明显更快）
CROSSREF_MAILTO=

# OpenAlex API Key（可选，在 openalex.org 免费申请）。
# 可用额度和鉴权要求以 OpenAlex 当前账户政策为准。
OPENALEX_API_KEY=

# 每次核查请求最多发起几次 OpenAlex 题名检索（保护额度）
OPENALEX_SEARCH_BUDGET=20

# AI 辅助解析：只提取原文已有字段，最终结论由数据库核验引擎决定。
# 密钥只用于服务端。未配置或调用失败时会明确回退标准核验。
# 配置了密钥时，标准核验还会用 DeepSeek 的搜索接口（搜索引擎，不是大模型）到知网、万方、维普核对中文期刊论文。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 每次核查请求最多联网核查几条中文期刊论文（保护搜索额度，默认 30）
CN_SEARCH_BUDGET=30
