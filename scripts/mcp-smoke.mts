// MCP Server 实连冒烟：像 Claude Desktop 一样用 stdio 启动服务端，列出工具并真实调用一次。
// 用法：pnpm smoke:mcp [--no-claim]   （--no-claim 跳过会调用 DeepSeek 的论断核查）
// 网络需要代理时先设置 NODE_USE_ENV_PROXY=1。结果写入 eval/results/mcp-smoke-*.json。
import { mkdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { fileURLToPath } from "node:url";
import { Client } from "@modelcontextprotocol/sdk/client/index.js";
import { StdioClientTransport } from "@modelcontextprotocol/sdk/client/stdio.js";

const root = fileURLToPath(new URL("..", import.meta.url));
const withClaim = !process.argv.includes("--no-claim");
const references = [
  "[1] Walters, W. H., & Wilder, E. I. (2023). Fabrication and errors in the bibliographic citations generated by ChatGPT. Scientific Reports, 13, 14045. https://doi.org/10.1038/s41598-023-41032-5",
  "[2] LeCun, Y., Bengio, Y., & Hinton, G. (2017). Deep learning. Nature, 521(7553), 436–444.",
].join("\n");

// 与 README 中给 Claude Desktop 的配置相同：pnpm --silent 不会往 stdout 写自己的提示
const transport = new StdioClientTransport({
  command: "pnpm",
  args: ["--silent", "--dir", root, "mcp"],
  env: { ...process.env } as Record<string, string>,
  stderr: "pipe",
});
const stderr: string[] = [];
transport.stderr?.on("data", (chunk) => stderr.push(String(chunk)));

const client = new Client({ name: "cite-checkup-smoke", version: "1.0.0" });
const started = Date.now();
await client.connect(transport);
const { tools } = await client.listTools();
console.log("工具：", tools.map((t) => t.name).join("、"));

const progress: string[] = [];
const verify = await client.callTool(
  { name: "verify_references", arguments: { references } },
  undefined,
  { onprogress: (p) => progress.push(`${p.progress}/${p.total} ${p.message ?? ""}`), timeout: 120_000 },
);
console.log((verify.content as { text: string }[])[0].text);

let claim: unknown;
if (withClaim) {
  claim = await client.callTool(
    { name: "check_claim", arguments: { claim: "在该研究样本中，GPT-3.5 生成引文的 55% 为虚构，GPT-4 为 18%。", doi: "10.1038/s41598-023-41032-5" } },
    undefined,
    { timeout: 120_000 },
  );
  console.log("\n" + ((claim as { content: { text: string }[] }).content[0].text));
}
await client.close();

const out = join(root, "eval", "results", `mcp-smoke-${new Date().toISOString().replace(/[:.]/g, "-")}.json`);
mkdirSync(join(root, "eval", "results"), { recursive: true });
writeFileSync(out, JSON.stringify({
  ranAt: new Date().toISOString(),
  transport: "stdio: pnpm --silent --dir <project> mcp",
  seconds: (Date.now() - started) / 1000,
  tools: tools.map((t) => ({ name: t.name, title: t.title, annotations: t.annotations })),
  verifyReferences: { isError: verify.isError ?? false, structuredContent: verify.structuredContent, progress },
  checkClaim: claim ? { isError: (claim as { isError?: boolean }).isError ?? false, structuredContent: (claim as { structuredContent?: unknown }).structuredContent } : "skipped",
  serverStderr: stderr.join("").trim().split("\n").filter((line) => !/EnvHttpProxyAgent|trace-warnings/.test(line)),
}, null, 1));
console.log(`\n记录已写入 ${out}`);
