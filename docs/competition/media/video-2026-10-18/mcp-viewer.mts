// Recording-only local client. All results come from the project's live stdio MCP server.
import { createServer, type IncomingMessage, type ServerResponse } from "node:http";
import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { resolve, join } from "node:path";
import { fileURLToPath } from "node:url";
import { Client } from "@modelcontextprotocol/sdk/client/index.js";
import { StdioClientTransport } from "@modelcontextprotocol/sdk/client/stdio.js";

const directory = fileURLToPath(new URL(".", import.meta.url));
const projectRoot = resolve(directory, "../../../..");
const evidenceDirectory = join(directory, "mcp");
const origin = "http://127.0.0.1:3211";
const references = [
  "[1] Walters, W. H., & Wilder, E. I. (2023). Fabrication and errors in the bibliographic citations generated by ChatGPT. Scientific Reports, 13, 14045. https://doi.org/10.1038/s41598-023-41032-5",
  "[2] LeCun, Y., Bengio, Y., & Hinton, G. (2017). Deep learning. Nature, 521(7553), 436–444.",
].join("\n");
mkdirSync(evidenceDirectory, { recursive: true });

let client: Client | undefined;
let transport: StdioClientTransport | undefined;
let busy = false;
let closing = false;

function saveEvidence(kind: string, body: unknown): string {
  const name = `${kind}-${new Date().toISOString().replace(/[:.]/g, "-")}.json`;
  writeFileSync(join(evidenceDirectory, name), JSON.stringify(body, null, 2), "utf8");
  return name;
}

function json(response: ServerResponse, status: number, body: unknown) {
  response.writeHead(status, { "Content-Type": "application/json; charset=utf-8" });
  response.end(JSON.stringify(body));
}

async function emptyObjectBody(request: IncomingMessage): Promise<boolean> {
  let body = "";
  for await (const chunk of request) {
    body += chunk.toString();
    if (body.length > 64) return false;
  }
  try {
    const data = JSON.parse(body || "{}");
    return !!data && typeof data === "object" && !Array.isArray(data) && Object.keys(data).length === 0;
  } catch { return false; }
}

async function connectAndList() {
  if (!client) {
    transport = new StdioClientTransport({
      command: "pnpm",
      args: ["--silent", "--dir", projectRoot, "mcp"],
      cwd: projectRoot,
      env: Object.fromEntries(Object.entries(process.env).filter((pair): pair is [string, string] => pair[1] !== undefined)),
      // Drain without exposing server stderr in the browser or evidence files.
      stderr: "pipe",
    });
    transport.stderr?.on("data", () => {});
    const candidate = new Client({ name: "cite-checkup-local-demo", version: "1.0.0" });
    try {
      await candidate.connect(transport);
      client = candidate;
      candidate.onclose = () => { client = undefined; };
    } catch {
      await candidate.close().catch(() => {});
      transport = undefined;
      throw new Error("connection_failed");
    }
  }
  return await client.listTools();
}

const server = createServer(async (request, response) => {
  response.setHeader("Cache-Control", "no-store");
  response.setHeader("X-Content-Type-Options", "nosniff");
  response.setHeader("Referrer-Policy", "no-referrer");
  response.setHeader("Content-Security-Policy", "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; img-src data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'");
  // Binding and Host/Origin checks keep this small demo surface on loopback.
  if (request.socket.remoteAddress !== "127.0.0.1" || request.headers.host !== "127.0.0.1:3211") {
    json(response, 403, { error: "仅限本机访问。" }); return;
  }
  if (request.method === "GET" && request.url === "/") {
    response.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
    response.end(readFileSync(join(directory, "mcp-viewer.html"), "utf8")); return;
  }
  if (request.method !== "POST" || !["/api/connect", "/api/verify"].includes(request.url ?? "")) {
    json(response, 404, { error: "未提供此操作。" }); return;
  }
  if (request.headers.origin !== origin || !request.headers["content-type"]?.startsWith("application/json") || !await emptyObjectBody(request)) {
    json(response, 403, { error: "仅接受本页的固定演示操作。" }); return;
  }
  if (busy) { json(response, 409, { error: "当前操作尚未完成，请稍候。" }); return; }
  busy = true;
  const startedAt = new Date().toISOString();
  const started = Date.now();
  try {
    if (request.url === "/api/connect") {
      const listed = await connectAndList();
      const tools = listed.tools.map(({ name, title, description, annotations }) => ({ name, title, description, annotations }));
      const record = saveEvidence("list-tools", {
        startedAt, completedAt: new Date().toISOString(), durationMs: Date.now() - started,
        transport: "stdio", command: "pnpm --silent --dir <project> mcp", live: true,
        client: "cite-checkup-local-demo", server: client?.getServerVersion(), tools,
      });
      json(response, 200, { connected: true, tools, record });
      return;
    }
    if (!client) { json(response, 409, { error: "请先连接并列出工具。" }); return; }
    response.writeHead(200, { "Content-Type": "application/x-ndjson; charset=utf-8" });
    response.flushHeaders();
    const events: unknown[] = [];
    const emit = (event: unknown) => { if (!response.destroyed) response.write(`${JSON.stringify(event)}\n`); };
    emit({ type: "started", startedAt });
    const result = await client.callTool(
      { name: "verify_references", arguments: { references } },
      undefined,
      { timeout: 180_000, onprogress: (progress) => {
        const event = { type: "progress", elapsedMs: Date.now() - started, ...progress };
        events.push(event); emit(event);
      } },
    );
    const completedAt = new Date().toISOString();
    const record = saveEvidence("verify-references", {
      startedAt, completedAt, durationMs: Date.now() - started,
      transport: "stdio", live: true, tool: "verify_references", input: { references },
      progress: events, result,
    });
    emit({ type: "result", completedAt, durationMs: Date.now() - started, record, result });
    response.end();
  } catch {
    const message = request.url === "/api/connect" ? "连接未完成，请重试。" : "本次核验未完成，请重试；没有生成核验结论。";
    saveEvidence("failed-operation", { startedAt, completedAt: new Date().toISOString(), action: request.url, message });
    if (response.headersSent) response.end(`${JSON.stringify({ type: "error", error: message })}\n`);
    else json(response, 503, { error: message });
  } finally { busy = false; }
});

server.requestTimeout = 200_000;
server.listen(3211, "127.0.0.1", () => console.log(`Local MCP demo ready: ${origin}`));

async function shutdown() {
  if (closing) return;
  closing = true;
  server.close();
  await client?.close().catch(() => {});
  await transport?.close().catch(() => {});
  process.exit(0);
}
process.on("SIGINT", () => { void shutdown(); });
process.on("SIGTERM", () => { void shutdown(); });
